# Environment Variables for Arc Escrow

# Sepolia RPC URL
# Example values:
# - https://rpc.sepolia.org
# - https://sepolia.infura.io/v3/<key>
SEPOLIA_RPC_URL=

# Deployment wallet private key (DO NOT COMMIT THIS FILE)
PRIVATE_KEY=your_private_key_here

# Treasury address for platform fees
TREASURY_ADDRESS=your_treasury_address_here

# Contract address (filled after deployment)
ARCESCROW_ADDRESS=
